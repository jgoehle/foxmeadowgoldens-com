# Canonical URL enforcement — .html always 301s to the clean URL.
# The ! forces the rule to win over the on-disk file of the same name.

/about.html    /about    301!
/contact.html    /contact    301!
/gallery.html    /gallery    301!
/index.html    /    301!
/privacy.html    /privacy    301!
/puppies.html    /puppies    301!
/thank-you.html    /thank-you    301!
